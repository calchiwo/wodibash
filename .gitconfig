[user]
    name = Caleb Wodi
    email = calebwodi33@gmail.com

[core]
    editor = code --wait
    autocrlf = true
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[color]
    ui = auto

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[alias]
    st = status
    co = checkout
    br = branch
    cm = commit
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

[diff]
    tool = vscode
    mnemonicPrefix = true
    renames = true

[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE

[help]
    autocorrect = 1