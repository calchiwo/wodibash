{
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "git.openRepositoryInParentFolders": "always",
    "workbench.editor.empty.hint": "hidden",
    "workbench.statusBar.visible": false,
    "makefile.configureOnOpen": true,
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.html": "default"
    },
    "terminal.integrated.initialHint": false,
    "workbench.editor.enablePreview": false,
    "diffEditor.codeLens": true,
    "editor.quickSuggestions": {
        "other": "off",
        "comments": "off",
        "strings": "off"
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.suggest.selectionMode": "never",
    "editor.wordBasedSuggestions": "off",
    "editor.parameterHints.enabled": false,
    "editor.snippetSuggestions": "none",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.tabCompletion": "off",
    "editor.autoClosingBrackets": "never",
    "editor.autoClosingQuotes": "never",
    "editor.autoClosingComments": "never",
    "editor.autoClosingDelete": "never",
    "editor.autoClosingOvertype": "never",
    "editor.surroundSelection": "never",
    "editor.language.colorizedBracketPairs": [],
    "editor.autoIndent": "none",
    "editor.formatOnType": false,
    "editor.formatOnPaste": false,
    "editor.trimAutoWhitespace": false,
    "editor.smartSelect.selectLeadingAndTrailingWhitespace": false,
    "editor.stickyTabStops": false,
    "emmet.enabled": false,
    "emmet.showAbbreviationSuggestions": false,
    "emmet.showExpandedAbbreviation": "never",
    "emmet.triggerExpansionOnTab": false,
    "html.autoClosingTags": false,
    "javascript.autoClosingTags": false,
    "typescript.autoClosingTags": false,
    "javascript.suggest.enabled": false,
    "html.completion.attributeDefaultValue": "empty",
    "typescript.suggest.autoImports": false,
    "typescript.suggest.enabled": false,
    "C_Cpp.autocomplete": "disabled",
    "editor.inlineSuggest.enabled": false,
    "github.copilot.enable": {
        "*": false
    },
    "github.copilot.renameSuggestions.triggerAutomatically": false,
    "chat.disableAIFeatures": true,
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.suggest.providers": {
        "vscode.terminal-suggest": false
    },
    "editor.lightbulb.enabled": "off",
    "livePreview.defaultPreviewPath": "/index.html"
}